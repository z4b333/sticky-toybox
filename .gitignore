.pio/
# Every host build, however it was named. Naming them one at a time is how
# preview_dbg -- a 2.7 MB compiled binary -- ended up committed.
test/host/preview*
test/host/test_logic
test/host/*.pgm
__pycache__/

# The harness dumps frames wherever it is run from, not only test/host.
*.pgm

# The Seeed registry entry, rebuilt by tools/make_registry.py from binaries
# that are already committed under docs/firmware. Four megabytes of duplicate
# blobs; it belongs in the registry's pull request, not in this repo.
dist/
